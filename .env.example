# Copy to .env for local work. settings.py reads the environment first, then
# .env, then Key Vault — so with these set no Azure is involved at all.

# The passcode the login form checks. In Azure this lives in Key Vault as
# APP-PASSCODE and is never set as an environment variable.
APP_PASSCODE=local

# Leave empty to keep each document in a local file (LOCAL_PROFILE_PATH/
# LOCAL_JOBS_PATH, default .career-profile.json/.career-jobs.json) rather
# than in blob storage.
PROFILE_CONTAINER_URL=
JOBS_CONTAINER_URL=

# Set to false to drop the login form entirely. Only ever sensible locally:
# the deployed app is reachable from the internet.
REQUIRE_PASSCODE=true

# Optional. Without this, sources/reed.py contributes nothing. Free key from
# reed.co.uk/developers.
REED_API_KEY=

# Optional. Without this, advancement.py's guidance step is skipped.
DEEPSEEK_API_KEY=

# Optional. Without both, `career digest` skips sending the weekly email
# (`make digest-preview` needs neither). The sender is DIGEST_FROM, which
# defaults to an address on career.jaywithers.uk — a domain verified in
# Resend.
RESEND_API_KEY=
DIGEST_TO=
